# =============================================================================
# Lenny Growth Assistant — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit your .env file — it is in .gitignore.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL with pgvector extension.
# When running via docker compose, use the service name "db".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lenny

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "ollama" for local inference or "anthropic" for cloud.
LLM_PROVIDER=ollama

# ── Ollama (Local) ───────────────────────────────────────────────────────────
# Base URL of your Ollama instance.
# When running via docker compose this should point to the host machine.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# The chat model to use. Must be already pulled in Ollama.
# Lightweight options: llama3.2, phi3
# Full options: llama3.1, llama3.2
OLLAMA_MODEL=llama3.2

# The embedding model to use for generating vector embeddings.
# Pull with: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Anthropic (Cloud) ────────────────────────────────────────────────────────
# Your Anthropic API key. Required only if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# The Anthropic model to use.
# Recommended: claude-3-5-haiku-20241022 (fast + affordable)
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Number of transcript chunks to retrieve per query.
RETRIEVAL_TOP_K=8

# Minimum similarity score (0.0-1.0) to include a chunk as a source.
RETRIEVAL_SCORE_THRESHOLD=0.5

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL of the backend API, as seen from the browser.
VITE_API_URL=http://localhost:8000
